# Defines the maximum global concurrency limit for all declared runner instances.
# Sized to enable parallel execution while preventing host system resource exhaustion.
concurrent = 4
check_interval = 0

[[runners]]
    name         = "${runner_name}"
    url          = "https://gitlab.com"
    token        = "${runner_token}"
    executor     = "docker"
    run_untagged = true
    [runners.docker]
        image                        = "alpine:latest"
        host                         = "unix:///run/podman/podman.sock"
        tls_verify                   = false # Podman Unix socket communicates over unencrypted HTTP; TLS verification causes connection failure.
        disable_entrypoint_overwrite = false
        oom_kill_disable             = false
        disable_cache                = false
        volumes                      = ["/cache"]
        shm_size                     = 0

# Dedicated to jobs tagged for SonarQube access; network_mode below is scoped to this runner
# alone so unrelated jobs are not placed on the shared bridge network by default.
[[runners]]
    name         = "${sonarqube_runner_name}"
    url          = "https://gitlab.com"
    token        = "${sonarqube_runner_token}"
    executor     = "docker"
    run_untagged = false
    [runners.docker]
        image                        = "alpine:latest"
        host                         = "unix:///run/podman/podman.sock"
        tls_verify                   = false
        disable_entrypoint_overwrite = false
        oom_kill_disable             = false
        disable_cache                = false
        volumes                      = ["/cache"]
        shm_size                     = 0
        network_mode                 = "sonarqube-ci-net" # Joins the shared bridge network so job containers reach SonarQube by service name.
