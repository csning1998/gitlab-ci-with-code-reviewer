#!/bin/sh
# Runs commitlint via the shared reviewer image, avoiding a local Node.js dependency.
# Activate with: git config core.hooksPath .githooks

set -e

IMAGE="registry.gitlab.com/csning1998-lab/gitlab-ci-with-code-reviewer/reviewer:edge"
MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# .git is mounted read-only (container_file_t:s0). The message file is mounted
# separately at /repo/COMMIT_EDITMSG to keep commitlint from writing into .git.
podman run --rm \
    -v "${REPO_ROOT}/.git":/repo/.git:ro \
    -v "$(realpath "${MSG_FILE}")":/repo/COMMIT_EDITMSG:ro \
    -w /repo \
    "$IMAGE" \
    commitlint --config /etc/commitlint/commitlint.config.cjs --cwd /repo --edit /repo/COMMIT_EDITMSG
