#!/bin/sh
# Validates local commit messages against the conventional commit specification using the
# shared reviewer container image, eliminating local Node.js dependency requirements.
# Activation command: git config core.hooksPath .githooks

set -e

IMAGE="registry.gitlab.com/csning1998/gitlab-ci-with-code-reviewer/reviewer:edge"
MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# The .git mount source is registered as container_file_t:s0. The
# message file is mounted at /repo/COMMIT_EDITMSG so commitlint does
# not create COMMIT_EDITMSG_HOOK under the read-only .git mount.
podman run --rm \
    -v "${REPO_ROOT}/.git":/repo/.git:ro \
    -v "$(realpath "${MSG_FILE}")":/repo/COMMIT_EDITMSG:ro \
    -w /repo \
    "$IMAGE" \
    commitlint --config /etc/commitlint/commitlint.config.cjs --cwd /repo --edit /repo/COMMIT_EDITMSG
