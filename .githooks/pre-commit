#!/bin/sh
# Blocks commits containing detected secrets using the official gitleaks image
# Activation command: git config core.hooksPath .githooks

set -e

IMAGE="docker.io/zricethezav/gitleaks:v8.30.1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# The mount source is registered as container_file_t:s0. No relabel
# flag and label=disable is PERMANENTLY PROHIBITED.
podman run --rm \
    -v "${REPO_ROOT}/.git":/repo/.git:ro \
    -w /repo \
    -e GIT_DIR=/repo/.git \
    -e GIT_WORK_TREE=/repo \
    "$IMAGE" \
    protect --staged --redact -v
